# ==============================================================================
# VOCERO CRM — CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env)
# ==============================================================================
# INSTRUCCIONES RÁPIDAS:
# 1. Copia este archivo a `.env` (`cp .env.example .env` o `copy .env.example .env`).
# 2. Reemplaza los valores de la SECCIÓN 1 (Obligatorios).
#    * Consejo: Puedes ejecutar `pnpm init-env` para autogenerar claves aleatorias seguras.
# ==============================================================================

# ==============================================================================
# SECCIÓN 1: CONFIGURACIÓN BÁSICA Y SEGURIDAD (OBLIGATORIO)
# ==============================================================================

# URL pública donde correrá la aplicación.
# En LOCAL con Docker Compose: https://localhost o http://localhost
# En PRODUCCIÓN: https://crm.tudominio.com (sin barra al final)
APP_BASE_URL=https://localhost

# Dominio para Caddy (provee HTTPS y enrutamiento interno en Docker Compose).
# En LOCAL: localhost
# En PRODUCCIÓN: crm.tudominio.com
DOMAIN=localhost

# Contraseña de la base de datos PostgreSQL local.
# Generar una segura (ej. PowerShell): -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 24 | % {[char]$_})
POSTGRES_PASSWORD=cambiar_por_un_password_seguro_postgres

# Cadena de conexión para la base de datos.
# Nota: Si usas docker-compose, el host es "postgres" (el nombre del servicio).
DATABASE_URL=postgresql://postgres:cambiar_por_un_password_seguro_postgres@postgres:5432/vocero

# Secreto de firma de sesiones de usuario (mínimo 32 caracteres).
# Generar (OpenSSL): openssl rand -base64 32
BETTER_AUTH_SECRET=cambiar_por_secreto_aleatorio_32_caracteres_base64_aqui

# Clave maestra de cifrado en reposo (AES-256-GCM) para tokens y secretos sensibles.
# IMPORTANTE: DEBE tener exactamente 32 bytes codificados en Base64 (44 caracteres).
# Generar (OpenSSL): openssl rand -base64 32
ENCRYPTION_KEY=cambiar_por_clave_exacta_de_32_bytes_base64_44_chars

# Clave de comunicación interna entre el CRM y el agente de IA (Nea).
# Mínimo 16 caracteres aleatorios.
BOT_API_KEY=cambiar_por_token_interno_del_bot_minimo_32_chars


# ==============================================================================
# SECCIÓN 2: INTEGRACIÓN CON WHATSAPP CLOUD API (META)
# ==============================================================================
# ¿De dónde obtener estos valores?
# 1. Entra a: https://developers.facebook.com/apps/
# 2. Crea o selecciona una app de tipo "Empresa" / "Business" y agrega el producto "WhatsApp".
# ==============================================================================

# Token de verificación para el Webhook de Meta.
# Tú defines este valor secreto (ej. una cadena aleatoria de 32 caracteres).
# Se coloca aquí y también en el panel de Meta al configurar el Webhook:
# Callback URL en Meta: https://crm.tudominio.com/api/webhooks/wa/<META_WEBHOOK_VERIFY_TOKEN>
# Verify Token en Meta: <META_WEBHOOK_VERIFY_TOKEN>
META_WEBHOOK_VERIFY_TOKEN=token_secreto_verificacion_webhook_32_caracteres

# Secreto de la aplicación de Meta (App Secret) para verificar firma HMAC-SHA256 (Opcional pero recomendado).
# Dónde obtenerlo: Developers Facebook -> Tu App -> Configuración de la app -> Básica -> Clave secreta de la app
META_APP_SECRET=

# Versión de Meta Graph API (dejar por defecto salvo actualización requerida).
META_GRAPH_API_VERSION=v25.0


# ==============================================================================
# SECCIÓN 3: INTELIGENCIA ARTIFICIAL Y AGENTE (NEA)
# ==============================================================================
# NOTA: En Vocero CRM v2.0, el modelo y la API Key de IA se pueden configurar
# directamente desde la interfaz web en: [Ajustes -> IA] (/settings/ai).
# Las siguientes variables sirven como valores de respaldo / por defecto:
# ==============================================================================

# Token de API del proveedor de IA.
# Dónde obtenerlo: https://openrouter.ai/keys (o cualquier proveedor compatible con OpenAI API).
OPENROUTER_API_TOKEN=

# URL base de la API del proveedor de IA:
# OpenRouter: https://openrouter.ai/api
# OpenAI: https://api.openai.com/v1
# Groq: https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Modelo principal para las respuestas del agente:
# Ejemplos: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, deepseek/deepseek-chat
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# Modelo para el Juez del Laboratorio de pruebas (opcional, si está vacío usa el principal):
OPENROUTER_JUDGE_MODEL=

# URLs internas de conexión con el agente Nea (en Docker Compose ya vienen configuradas):
BRAIN_HEALTH_URL=http://nea:8000/health
BRAIN_DISPATCH_URL=http://nea:8000/vocero/dispatch

# Filtro de prueba de WhatsApp (Opcional):
# Si colocas tu número telefónico (ej. 51999999999), el agente SOLO responderá a ese número.
# Vacío = El agente responde a todos los números que escriban.
ALLOWED_WA_IDS=

# Tiempo de espera (en milisegundos) para agrupar mensajes seguidos de un cliente antes de responder (default 6000):
AGENT_COALESCE_MS=6000


# ==============================================================================
# SECCIÓN 4: OPCIONES ADICIONALES DEL SISTEMA
# ==============================================================================

# Permitir registro público en /register (true para registrar administradores locales):
ALLOW_SIGNUP=true

# Canales adicionales habilitados (separados por coma). WhatsApp siempre está activo.
# Opciones disponibles: whatsapp,instagram,messenger,tiktok
# CHANNELS=whatsapp,instagram,messenger,tiktok

# Módulo de Agenda y citas: "on" para activar, dejar vacío para desactivar.
# AGENDA=on

# Módulo de Atribución y CAPI (Meta Conversions API): "on" para activar, dejar vacío para desactivar.
# ATRIBUCION=on

# Almacenamiento de archivos (Imágenes, audios, documentos):
# Por defecto se usa almacenamiento en volumen local (/data/media).
# Si prefieres S3 / MinIO / Cloudflare R2, descomenta:
# MEDIA_STORE=bucket
# MEDIA_BUCKET_ENDPOINT=http://minio:9000
# MEDIA_BUCKET_NAME=vocero
# MEDIA_BUCKET_REGION=us-east-1
# MEDIA_BUCKET_KEY_ID=
# MEDIA_BUCKET_SECRET=
